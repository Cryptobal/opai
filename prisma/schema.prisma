model CrmFollowUpConfig {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId              String   @unique @map("tenant_id")
  firstFollowUpDays     Int      @default(3) @map("first_followup_days")
  secondFollowUpDays    Int      @default(7) @map("second_followup_days")
  thirdFollowUpDays     Int      @default(3) @map("third_followup_days") // días después del 2do seguimiento
  firstEmailTemplateId  String?  @map("first_email_template_id") @db.Uuid
  secondEmailTemplateId String?  @map("second_email_template_id") @db.Uuid
  thirdEmailTemplateId  String?  @map("third_email_template_id") @db.Uuid
  whatsappFirstEnabled  Boolean  @default(true) @map("whatsapp_first_enabled")
  whatsappSecondEnabled Boolean  @default(true) @map("whatsapp_second_enabled")
  whatsappThirdEnabled  Boolean  @default(true) @map("whatsapp_third_enabled")
  autoAdvanceStage      Boolean  @default(true) @map("auto_advance_stage")
  firstFollowUpStageId  String?  @map("first_followup_stage_id") @db.Uuid
  secondFollowUpStageId String?  @map("second_followup_stage_id") @db.Uuid
  pauseOnReply          Boolean  @default(true) @map("pause_on_reply")
  sendHour              Int      @default(9) @map("send_hour") // 0-23, hora local de envío
  isActive              Boolean  @default(true) @map("is_active")
  bccEnabled            Boolean  @default(false) @map("bcc_enabled")
  bccEmail              String?  @map("bcc_email") // Copia oculta a este correo
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  firstFollowUpStage  CrmPipelineStage? @relation("crm_followup_first_stage", fields: [firstFollowUpStageId], references: [id], onDelete: SetNull)
  secondFollowUpStage CrmPipelineStage? @relation("crm_followup_second_stage", fields: [secondFollowUpStageId], references: [id], onDelete: SetNull)

  @@index([tenantId], map: "idx_crm_followup_config_tenant")
  @@index([firstFollowUpStageId], map: "idx_crm_followup_config_first_stage")
  @@index([secondFollowUpStageId], map: "idx_crm_followup_config_second_stage")
  @@map("crm_followup_config")
  @@schema("crm")
}

model CrmFollowUpLog {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String    @map("tenant_id")
  dealId         String    @map("deal_id") @db.Uuid
  sequence       Int // 1 = primer seguimiento, 2 = segundo
