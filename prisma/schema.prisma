  status         String    @default("borrador") // borrador | en_curso | completada

  // Seguridad actual
  currentSecurityCompany String?  @map("current_security_company")
  hasSecurityCurrently   Boolean? @map("has_security_currently")
  guardsNeeded           Int?     @map("guards_needed")
  guardShiftType         String?  @map("guard_shift_type")
  guardSalaryRange       String?  @map("guard_salary_range")

  // Servicios adicionales
  requiresTransport  Boolean @default(false) @map("requires_transport")
  transportNotes     String? @map("transport_notes")
  requiresMeals      Boolean @default(false) @map("requires_meals")
  mealNotes          String? @map("meal_notes")
  requiresExams      Boolean @default(false) @map("requires_exams")
  examNotes          String? @map("exam_notes")
  requiresEquipment  Boolean @default(false) @map("requires_equipment")
  equipmentNotes     String? @map("equipment_notes")
  requiresUniform    Boolean @default(false) @map("requires_uniform")
  uniformNotes       String? @map("uniform_notes")
  additionalCosts    Json?   @map("additional_costs")

