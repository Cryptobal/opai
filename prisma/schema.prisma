// ============================================
// OPS MODULE (Operaciones, TE, Personas)
// ============================================

model OpsPersona {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId              String    @map("tenant_id")
  firstName             String    @map("first_name")
  lastName              String    @map("last_name")
  rut                   String?
  email                 String?
  phone                 String?
  phoneMobile           String?   @map("phone_mobile")
  addressFormatted      String?   @map("address_formatted")
  googlePlaceId         String?   @map("google_place_id")
  addressLine1          String?   @map("address_line_1")
  commune               String?
  city                  String?
  region                String?
  lat                   Decimal?  @db.Decimal(10, 7)
  lng                   Decimal?  @db.Decimal(10, 7)
  addressSource         String?   @default("google_places") @map("address_source")
  birthDate             DateTime? @map("birth_date") @db.Date
  sex                   String?
  nacionalidad          String?
  afp                   String?
  healthSystem          String?   @map("health_system")
  isapreName            String?   @map("isapre_name")
  isapreHasExtraPercent Boolean?  @default(false) @map("isapre_has_extra_percent")
  isapreExtraPercent    Decimal?  @map("isapre_extra_percent") @db.Decimal(5, 2)
  hasMobilization       Boolean?  @default(false) @map("has_mobilization")
  // ── Datos previsionales (DL 3500, Ley 19.728) ──
  regimenPrevisional    String?   @map("regimen_previsional") // general | menor_18 | aprendizaje | extranjero | pensionado_invalidez | pensionado_vejez | pensionado_anticipada | pensionado_ffaa | exento_edad
  tipoPension           String?   @map("tipo_pension") // invalidez_total | invalidez_parcial | vejez | anticipada | ffaa
  isJubilado            Boolean?  @map("is_jubilado")
  cotizaAFP             Boolean?  @map("cotiza_afp") // Si jubilado: opta por cotizar AFP voluntariamente
  cotizaAFC             Boolean?  @map("cotiza_afc") // Si jubilado: cotiza AFC (solo invalidez parcial o casa particular)
  cotizaSalud           Boolean?  @default(true) @map("cotiza_salud")
  // ── Resolución Exenta N°38 ──
  personalEmail         String?   @map("personal_email") // Email personal del trabajador (obligatorio Res. 38)
  status                String    @default("active")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  guardia OpsGuardia?

  @@index([tenantId], map: "idx_ops_personas_tenant")
  @@index([status], map: "idx_ops_personas_status")
  @@index([rut], map: "idx_ops_personas_rut")
  @@map("personas")
  @@schema("ops")
}

model OpsGuardia {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId              String    @map("tenant_id")
  personaId             String    @unique @map("persona_id") @db.Uuid
  code                  String?
  status                String    @default("active")
  lifecycleStatus       String    @default("postulante") @map("lifecycle_status")
  hiredAt               DateTime? @map("hired_at") @db.Date
  terminatedAt          DateTime? @map("terminated_at") @db.Date
  terminationReason     String?   @map("termination_reason")
  isBlacklisted         Boolean   @default(false) @map("is_blacklisted")
  blacklistReason       String?   @map("blacklist_reason")
  blacklistedAt         DateTime? @map("blacklisted_at") @db.Timestamptz(6)
  availableExtraShifts  Boolean   @default(false) @map("available_extra_shifts")
  marcacionPin          String?   @map("marcacion_pin") // bcrypt hash del PIN de 4-6 dígitos
  marcacionPinVisible   String?   @map("marcacion_pin_visible") // PIN activo visible en ficha para operación

  // ── Face ID (AWS Rekognition) ──
  faceIdRegistered      Boolean   @default(false) @map("face_id_registered")
  faceIdAwsId           String?   @map("face_id_aws_id") // AWS Rekognition FaceId
  faceIdPhotoUrl        String?   @map("face_id_photo_url") // R2 URL de foto de referencia
  faceIdPhotoKey        String?   @map("face_id_photo_key") // R2 storage key
  faceIdRegisteredAt    DateTime? @map("face_id_registered_at") @db.Timestamptz(6)
  faceIdConsentAt       DateTime? @map("face_id_consent_at") @db.Timestamptz(6)
  faceIdConsentRevoked  Boolean   @default(false) @map("face_id_consent_revoked")
  currentInstallationId String?   @map("current_installation_id") @db.Uuid
  montoAnticipo         Int       @default(0) @map("monto_anticipo")
  recibeAnticipo        Boolean   @default(false) @map("recibe_anticipo")
  salaryStructureId     String?   @map("salary_structure_id") @db.Uuid
  os10                  Boolean?  @map("os10")

  // ── Contract tracking (Código del Trabajo - plazo fijo / indefinido) ──
  contractType               String?   @default("indefinido") @map("contract_type") // "plazo_fijo" | "indefinido"
  contractStartDate          DateTime? @map("contract_start_date") @db.Date
  contractPeriod1End         DateTime? @map("contract_period_1_end") @db.Date // Fin del período original (plazo fijo, hasta 1 año)
  contractPeriod2End         DateTime? @map("contract_period_2_end") @db.Date // Fin de la 1ra renovación
  contractPeriod3End         DateTime? @map("contract_period_3_end") @db.Date // Fin de la 2da renovación
  contractCurrentPeriod      Int?      @default(1) @map("contract_current_period") // 1, 2 o 3
  contractBecameIndefinidoAt DateTime? @map("contract_became_indefinido_at") @db.Date
  contractAlertDaysBefore    Int?      @default(5) @map("contract_alert_days_before") // Días hábiles antes para alertar

  // ── Resolución Exenta N°38 — Jornada excepcional & Face ID ──
  dtResolucionJornada   String?   @map("dt_resolucion_jornada")   // N° resolución DT de jornada excepcional
  dtResolucionVigencia  DateTime? @map("dt_resolucion_vigencia") @db.Date // Fecha de vencimiento de la resolución
  tipoJornada           String    @default("excepcional") @map("tipo_jornada") // ordinaria | excepcional
  maxHorasSemanales     Float     @default(42) @map("max_horas_semanales") // Configurable (Ley 40h)
  personalEmail         String?   @map("personal_email") // Email PERSONAL del guardia (obligatorio Res. 38)

  // ── TE (Turno Extra) quick-entry fields ──
  estadoUniforme       String?  @map("estado_uniforme") // "completo" | "incompleto"
  prendasFaltantes     String?  @map("prendas_faltantes") @db.Text
  validadoAntecedentes Boolean? @map("validado_antecedentes") // Solo Admin/RRHH pueden editar
  notaEvaluacion       String?  @map("nota_evaluacion") // "bueno" | "regular" | "malo"
  comentarioEvaluacion String?  @map("comentario_evaluacion") @db.Text
  teRegistradoPor      String?  @map("te_registrado_por") // Admin ID del supervisor que ingresó

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  persona                     OpsPersona                   @relation(fields: [personaId], references: [id], onDelete: Cascade)
  currentInstallation         CrmInstallation?             @relation("ops_guardia_current_installation", fields: [currentInstallationId], references: [id], onDelete: SetNull)
  salaryStructure             PayrollSalaryStructure?      @relation("ops_guardia_salary_structure", fields: [salaryStructureId], references: [id], onDelete: SetNull)
  bankAccounts                OpsCuentaBancaria[]
  flags                       OpsGuardiaFlag[]
  comments                    OpsComentarioGuardia[]
  documents                   OpsDocumentoPersona[]
  historyEvents               OpsGuardiaHistory[]
  guardEvents                 OpsGuardEvent[]
  pautas                      OpsPautaMensual[]            @relation("ops_pauta_guardia")
  pautasReemplazo             OpsPautaMensual[]            @relation("ops_pauta_reemplazo_guardia")
  asistenciasPlanificadas     OpsAsistenciaDiaria[]        @relation("ops_asistencia_planificada_guardia")
  asistenciasReales           OpsAsistenciaDiaria[]        @relation("ops_asistencia_real_guardia")
  asistenciasReemplazo        OpsAsistenciaDiaria[]        @relation("ops_asistencia_reemplazo_guardia")
  turnosExtra                 OpsTurnoExtra[]              @relation("ops_turno_extra_guardia")
  asignaciones                OpsAsignacionGuardia[]       @relation("ops_asignacion_guardia")
  seriesAsignadas             OpsSerieAsignacion[]         @relation("ops_serie_guardia")
  eventosRrhh                 OpsEventoRrhh[]
  pagoItems                   OpsPagoTeItem[]              @relation("ops_pago_item_guardia")
  refuerzoSolicitudes         OpsRefuerzoSolicitud[]
  marcaciones                 OpsMarcacion[]
  rondaEjecuciones            OpsRondaEjecucion[]
  rondaMarcaciones            OpsMarcacionCheckpoint[]
  rondaIncidentes             OpsRondaIncidente[]
  controlNocturnoGuardias     OpsControlNocturnoGuardia[]
  tickets                     OpsTicket[]
  inventoryGuardiaAssignments InventoryGuardiaAssignment[]
  inventoryMovements          InventoryMovement[]
  supervisionEvaluations      OpsSupervisionGuardEvaluation[] @relation("supervision_guard_evaluation_guard")
  supervisionFindings         OpsSupervisionFinding[]         @relation("supervision_finding_guard")
  examAssignments             ExamAssignment[]
  rondaAlertas                OpsAlertaRonda[]                @relation("alertaGuardia")
  patrolSessions              OpsPatrullajeSesion[]
  checkpointTaskResponses     OpsCheckpointTaskResponse[]
  devicePairingsAsCurrentGuard DevicePairing[]                @relation("device_pairing_current_guard")
  guardSelectionLogsFrom       GuardSelectionLog[]            @relation("guard_selection_from")
