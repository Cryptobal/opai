  contacts Json?

  // Informe
  generalReport    String? @map("general_report") @db.Text
  securityRisks    String? @map("security_risks") @db.Text
  recommendations  String? @map("recommendations") @db.Text
  photos           Json?
  durationMinutes  Int?    @map("duration_minutes")

  // Encuesta cliente
  surveyContactName     String? @map("survey_contact_name")
  surveyContactRole     String? @map("survey_contact_role")
