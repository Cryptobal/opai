  @@index([installationId], map: "idx_inv_phone_assign_installation")
  @@index([assignedToUserId], map: "idx_inv_phone_assign_user")
  @@map("phone_line_assignments")
  @@schema("inventory")
}

// ═══════════════════════════════════════════════════════════════════════════════
// UNIFIED CONTEXTUAL NOTES SYSTEM
// Schema: notes
// ═══════════════════════════════════════════════════════════════════════════════

enum NoteContextType {
  LEAD
  ACCOUNT
  INSTALLATION
  DEAL
  CONTACT
  QUOTATION
  GUARD
  DOCUMENT
  SHIFT // OpsTurnoExtra
  REINFORCEMENT_SHIFT // OpsRefuerzoSolicitud
  PAYROLL_RECORD // PayrollLiquidacion
  INVOICE // FinanceDte
  OPERATION // OpsControlNocturno
  SUPPLIER // FinanceSupplier
  TICKET // OpsTicket
  RENDICION // FinanceRendicion
  PUESTO // OpsPuestoOperativo
  PAUTA_MENSUAL // OpsPautaMensual
  SUPERVISION_VISIT // OpsVisitaSupervision
  SUPERVISION       // Supervision module-level notes

  @@schema("notes")
}

enum NoteType {
  GENERAL
  ALERT
  DECISION
  TASK

  @@schema("notes")
}

enum MentionType {
  USER
  ALL
  ROLE

  @@schema("notes")
}

enum NoteVisibility {
  PUBLIC
  PRIVATE
  GROUP

  @@schema("notes")
}

// ── Note (unified notes) ──

model Note {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String          @map("tenant_id")
  contextType     NoteContextType @map("context_type")
  contextId       String          @map("context_id")
  authorId        String          @map("author_id")
  content         String          @db.Text
  contentHtml     String?         @map("content_html") @db.Text
  noteType        NoteType        @default(GENERAL) @map("note_type")
  visibility      NoteVisibility  @default(PUBLIC)
  visibleToUsers  String[]        @default([]) @map("visible_to_users")
  parentNoteId    String?         @map("parent_note_id") @db.Uuid
  threadDepth     Int             @default(0) @map("thread_depth")
  metadata        Json?           @db.JsonB
  attachments     Json?           @db.JsonB // [{id, fileName, fileUrl, fileType, fileSize}]
  embedding       Float[]         @default([])
  aiSummary       String?         @map("ai_summary") @db.Text
  aiTags          String[]        @default([]) @map("ai_tags")
  aiSentiment     String?         @map("ai_sentiment")
  aiRelevant      Boolean         @default(true) @map("ai_relevant")
  isEdited        Boolean         @default(false) @map("is_edited")
  isPinned        Boolean         @default(false) @map("is_pinned")
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?         @map("deleted_by")
  legacyCrmNoteId String?         @unique @map("legacy_crm_note_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  author       Admin                 @relation("note_author", fields: [authorId], references: [id], onDelete: Cascade)
  parentNote   Note?                 @relation("NoteThread", fields: [parentNoteId], references: [id], onDelete: Cascade)
  replies      Note[]                @relation("NoteThread")
  mentions     NoteMention[]
  reactions    NoteReaction[]
  readStatuses NoteReadStatus[]      @relation("NoteReadStatusNote")
  entityRefs   NoteEntityReference[]

  @@index([tenantId, contextType, contextId, createdAt(sort: Desc)], map: "idx_notes_tenant_context_created")
  @@index([tenantId, authorId], map: "idx_notes_tenant_author")
  @@index([tenantId, parentNoteId], map: "idx_notes_tenant_parent")
  @@index([tenantId, noteType], map: "idx_notes_tenant_type")
  @@index([tenantId, contextType, contextId, visibility], map: "idx_notes_tenant_context_visibility")
  @@index([tenantId, isPinned, contextType, contextId], map: "idx_notes_tenant_pinned_context")
  @@index([tenantId, deletedAt], map: "idx_notes_tenant_soft_delete")
  @@map("notes")
  @@schema("notes")
}

// ── NoteMention ──

model NoteMention {
  id               String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String      @map("tenant_id")
  noteId           String      @map("note_id") @db.Uuid
  mentionType      MentionType @map("mention_type")
  mentionedUserId  String?     @map("mentioned_user_id")
  mentionedRole    String?     @map("mentioned_role")
  isRead           Boolean     @default(false) @map("is_read")
  readAt           DateTime?   @map("read_at") @db.Timestamptz(6)
  notificationSent Boolean     @default(false) @map("notification_sent")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([tenantId, mentionedUserId, isRead], map: "idx_note_mentions_user_read")
  @@index([tenantId, noteId], map: "idx_note_mentions_note")
  @@map("note_mentions")
  @@schema("notes")
}

// ── NoteReadStatus ──

model NoteReadStatus {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String           @map("tenant_id")
  userId      String           @map("user_id")
  contextType NoteContextType? @map("context_type")
  contextId   String?          @map("context_id")
  noteId      String?          @map("note_id") @db.Uuid
  lastReadAt  DateTime         @map("last_read_at") @db.Timestamptz(6)

  note Note? @relation("NoteReadStatusNote", fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, contextType, contextId], map: "uq_note_read_status_user_context")
  @@index([tenantId, userId], map: "idx_note_read_status_user")
  @@map("note_read_statuses")
  @@schema("notes")
}

// ── NoteReaction ──

model NoteReaction {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id")
  noteId    String   @map("note_id") @db.Uuid
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([tenantId, noteId, userId, emoji], map: "uq_note_reaction_user_emoji")
  @@index([tenantId, noteId], map: "idx_note_reactions_note")
  @@map("note_reactions")
  @@schema("notes")
}

// ── NoteEntityReference (cross-references between notes and entities) ──

model NoteEntityReference {
  id                    String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId              String          @map("tenant_id")
  noteId                String          @map("note_id") @db.Uuid
  referencedEntityType  NoteContextType @map("referenced_entity_type")
  referencedEntityId    String          @map("referenced_entity_id")
  referencedEntityLabel String          @map("referenced_entity_label")
  referencedEntityCode  String?         @map("referenced_entity_code")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([tenantId, noteId], map: "idx_note_entity_refs_note")
  @@index([tenantId, referencedEntityType, referencedEntityId], map: "idx_note_entity_refs_entity")
  @@map("note_entity_references")
  @@schema("notes")
}

// ── EntityFollower (users following entity contexts for notifications) ──

model EntityFollower {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String          @map("tenant_id")
  userId          String          @map("user_id")
  contextType     NoteContextType @map("context_type")
  contextId       String          @map("context_id")
  autoFollow      Boolean         @default(true) @map("auto_follow")
  notifyOnAll     Boolean         @default(true) @map("notify_on_all")
  notifyOnMention Boolean         @default(true) @map("notify_on_mention")
  notifyOnAlert   Boolean         @default(true) @map("notify_on_alert")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, userId, contextType, contextId], map: "uq_entity_follower_user_context")
  @@index([tenantId, contextType, contextId], map: "idx_entity_followers_context")
  @@index([tenantId, userId], map: "idx_entity_followers_user")
  @@map("entity_followers")
  @@schema("notes")
}

// ── AiContextSummary (AI-generated summaries per entity context) ──

model AiContextSummary {
  id           String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String          @map("tenant_id")
  contextType  NoteContextType @map("context_type")
  contextId    String          @map("context_id")
  summary      String          @db.Text
  periodStart  DateTime        @map("period_start") @db.Timestamptz(6)
  periodEnd    DateTime        @map("period_end") @db.Timestamptz(6)
  noteCount    Int             @map("note_count")
  topics       String[]        @default([])
  decisions    Json?           @db.JsonB
  pendingTasks Json?           @map("pending_tasks") @db.JsonB
  embedding    Float[]         @default([])
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, contextType, contextId], map: "idx_ai_context_summaries_context")
  @@index([tenantId, periodEnd(sort: Desc)], map: "idx_ai_context_summaries_period")
  @@map("ai_context_summaries")
  @@schema("notes")
}

// ══════════════════════════════════════════════════════════════════
// ██  CHAT — Sistema de Chat por Instalación
// ══════════════════════════════════════════════════════════════════

enum ChatSenderType {
  ADMIN
  GUARD
  CLIENT
  SYSTEM

  @@schema("chat")
}

enum ChatChannelType {
  INSTALLATION
  GROUP
  DIRECT
  EXTERNAL

  @@map("channel_type")
  @@schema("chat")
}

enum ChatParticipantType {
  ADMIN
  CONTACT

  @@schema("chat")
}

// ── ChatChannel ──

model ChatChannel {
  id                 String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId           String          @map("tenant_id")
  channelType        ChatChannelType @default(INSTALLATION) @map("channel_type")
  installationId     String?         @map("installation_id") @db.Uuid
  subType            String?         @map("sub_type")
  groupId            String?         @map("group_id")
  accountId          String?         @map("account_id") @db.Uuid
  name               String
  isActive           Boolean         @default(true) @map("is_active")
  lastMessageAt      DateTime?       @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview String?         @map("last_message_preview") @db.Text
  messageCount       Int             @default(0) @map("message_count")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  installation            CrmInstallation?              @relation(fields: [installationId], references: [id], onDelete: Cascade)
  messages                ChatMessage[]
  readCursors             ChatReadCursor[]
  notificationPreferences ChatNotificationPreference[]
  dmParticipants          ChatDmParticipant[]
  participants            ChatChannelParticipant[]
  archives                ChatChannelArchive[]

  @@index([tenantId], map: "idx_chat_channels_tenant")
  @@index([tenantId, channelType], map: "idx_chat_channels_tenant_type")
  @@index([tenantId, lastMessageAt(sort: Desc)], map: "idx_chat_channels_tenant_last_msg")
  @@index([groupId], map: "idx_chat_channels_group")
  @@unique([installationId, subType], map: "chat_channels_installation_sub_type_key")
  @@map("channels")
  @@schema("chat")
}

// ── ChatMessage ──

model ChatMessage {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String         @map("tenant_id")
  channelId       String         @map("channel_id") @db.Uuid
  senderType      ChatSenderType @map("sender_type")
  senderAdminId   String?        @map("sender_admin_id")
  senderGuardiaId String?        @map("sender_guardia_id") @db.Uuid
  senderContactId String?        @map("sender_contact_id") @db.Uuid
  senderName      String         @map("sender_name")
  senderAvatar    String?        @map("sender_avatar")
  content         String         @db.Text
  contentHtml     String?        @map("content_html") @db.Text
  replyToId       String?        @map("reply_to_id") @db.Uuid
  threadRootId    String?        @map("thread_root_id") @db.Uuid
  replyCount      Int            @default(0) @map("reply_count")
  lastReplyAt     DateTime?      @map("last_reply_at") @db.Timestamptz(6)
  attachments     Json?          @db.JsonB
  systemEventType String?        @map("system_event_type")
  systemEventData Json?          @map("system_event_data") @db.JsonB
  isEdited        Boolean        @default(false) @map("is_edited")
  editedAt        DateTime?      @map("edited_at") @db.Timestamptz(6)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?        @map("deleted_by")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  channel       ChatChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  replyTo       ChatMessage?          @relation("ChatMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       ChatMessage[]         @relation("ChatMessageReply")
  threadRoot    ChatMessage?          @relation("ChatMessageThread", fields: [threadRootId], references: [id], onDelete: Cascade)
  threadReplies ChatMessage[]         @relation("ChatMessageThread")
  reactions     ChatMessageReaction[]
  mentions      ChatMention[]

  @@index([tenantId, channelId, createdAt(sort: Desc)], map: "idx_chat_messages_channel_created")
  @@index([channelId, createdAt], map: "idx_chat_messages_channel_asc")
  @@index([senderAdminId], map: "idx_chat_messages_sender_admin")
  @@index([senderGuardiaId], map: "idx_chat_messages_sender_guardia")
  @@index([senderContactId], map: "idx_chat_messages_sender_contact")
  @@index([replyToId], map: "idx_chat_messages_reply_to")
  @@index([threadRootId, createdAt], map: "idx_chat_messages_thread_root")
  @@map("messages")
  @@schema("chat")
}

// ── ChatMessageReaction ──

model ChatMessageReaction {
  id         String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String         @map("tenant_id")
  messageId  String         @map("message_id") @db.Uuid
  senderType ChatSenderType @map("sender_type")
  senderId   String         @map("sender_id")
  senderName String         @map("sender_name")
  emoji      String
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, senderId, emoji], map: "uq_chat_reaction_user_emoji")
  @@index([messageId], map: "idx_chat_reactions_message")
  @@map("message_reactions")
  @@schema("chat")
}

// ── ChatReadCursor ──

model ChatReadCursor {
  id                String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId          String         @map("tenant_id")
  channelId         String         @map("channel_id") @db.Uuid
  readerType        ChatSenderType @map("reader_type")
  readerId          String         @map("reader_id")
  lastReadAt        DateTime       @map("last_read_at") @db.Timestamptz(6)
  lastReadMessageId String?        @map("last_read_message_id") @db.Uuid

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, readerType, readerId], map: "uq_chat_read_cursor_user_channel")
  @@index([tenantId, readerId, readerType], map: "idx_chat_read_cursors_reader")
  @@map("read_cursors")
  @@schema("chat")
}

// ── ChatMention ──

model ChatMention {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String   @map("tenant_id")
  messageId       String   @map("message_id") @db.Uuid
  mentionType     String   @map("mention_type") // 'USER' or 'ALL'
  mentionedUserId String?  @map("mentioned_user_id") // admin cuid if USER
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "idx_chat_mentions_message")
  @@index([mentionedUserId, createdAt(sort: Desc)], map: "idx_chat_mentions_user")
  @@map("mentions")
  @@schema("chat")
}

// ── ChatNotificationPreference ──

model ChatNotificationPreference {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String   @map("tenant_id")
  channelId  String   @map("channel_id") @db.Uuid
  userType   String   @map("user_type") // 'ADMIN', 'GUARD', 'CLIENT'
  userId     String   @map("user_id")
  preference String   @default("ALL") // 'ALL', 'MENTIONS_ONLY', 'MUTED'
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userType, userId], map: "uq_chat_notif_pref_channel_user")
  @@index([userId, userType], map: "idx_chat_notif_prefs_user")
  @@map("notification_preferences")
  @@schema("chat")
}

// ── ChatPushSubscription ──

model ChatPushSubscription {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String         @map("tenant_id")
  subscriberType ChatSenderType @map("subscriber_type")
  subscriberId   String         @map("subscriber_id")
  endpoint       String         @db.Text
  p256dh         String         @map("p256dh") @db.Text
  auth           String         @db.Text
  userAgent      String?        @map("user_agent")
  portalType     String?        @map("portal_type")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([endpoint], map: "uq_chat_push_subscription_endpoint")
  @@index([tenantId, subscriberType, subscriberId], map: "idx_chat_push_subscriptions_subscriber")
  @@map("push_subscriptions")
  @@schema("chat")
}

// ── ChatDmParticipant ──

model ChatDmParticipant {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  channelId String   @map("channel_id") @db.Uuid
  adminId   String   @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, adminId], map: "uq_chat_dm_participant")
  @@index([adminId], map: "idx_chat_dm_participants_admin")
  @@map("dm_participants")
  @@schema("chat")
}

// ── ChatChannelParticipant ──
// Used by EXTERNAL channels to track mixed ADMIN + CONTACT participants.
// (Internal DMs use ChatDmParticipant instead.)

model ChatChannelParticipant {
  id              String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  channelId       String      @map("channel_id") @db.Uuid
  participantType ChatParticipantType @map("participant_type")
  participantId   String      @map("participant_id")
  joinedAt        DateTime    @default(now()) @map("joined_at") @db.Timestamptz(6)

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, participantType, participantId], map: "uq_chat_channel_participant")
  @@index([participantType, participantId], map: "idx_chat_channel_participants_participant")
  @@map("channel_participants")
  @@schema("chat")
}

// ── ChatChannelArchive ──
// Per-user archiving (like Slack). Archiving one channel does NOT affect other participants.

model ChatChannelArchive {
  id         String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  channelId  String      @map("channel_id") @db.Uuid
  adminId    String      @map("admin_id")
  archivedAt DateTime    @default(now()) @map("archived_at") @db.Timestamptz(6)

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, adminId], map: "uq_chat_channel_archive")
  @@index([adminId], map: "idx_chat_channel_archives_admin")
  @@map("channel_archives")
  @@schema("chat")
}

// ══════════════════════════════════════════════════════════════
//  ACCESS CONTROL MODULE
// ══════════════════════════════════════════════════════════════

model AccessControlConfig {
  id                   String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId             String   @map("tenant_id")
  installationId       String   @unique @map("installation_id") @db.Uuid
  enabledRecordTypes   String[] @default([]) @map("enabled_record_types") // ['visit','provider','vehicle','staff','delivery']
  useWhitelist         Boolean  @default(false) @map("use_whitelist")
  useBlacklist         Boolean  @default(false) @map("use_blacklist")
  requireIdValidation  Boolean  @default(false) @map("require_id_validation")
  requirePhoto         Boolean  @default(false) @map("require_photo")
  requireSignature     Boolean  @default(false) @map("require_signature")
  maxStayHours         Int?     @map("max_stay_hours")
  autoReportSchedule   String?  @map("auto_report_schedule") // 'daily','weekly','monthly'
  formConfig           Json     @default("{}") @map("form_config") @db.JsonB
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  installation CrmInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_ac_configs_tenant")
  @@map("access_control_configs")
  @@schema("access_control")
}

model AccessControlList {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String    @map("tenant_id")
  installationId  String?   @map("installation_id") @db.Uuid
  listType        String    @map("list_type") // 'whitelist' | 'blacklist'
  rut             String
  fullName        String    @map("full_name")
  company         String?
  blockReason     String?   @map("block_reason")
  scope           String    @default("local") // 'local' | 'global'
  validFrom       DateTime? @map("valid_from") @db.Date
  validUntil      DateTime? @map("valid_until") @db.Date
  allowedDays     Int[]     @default([]) @map("allowed_days") // 0=dom, 1=lun, ..., 6=sab
  allowedTimeFrom String?   @map("allowed_time_from")
  allowedTimeTo   String?   @map("allowed_time_to")
  isActive        Boolean   @default(true) @map("is_active")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  installation    CrmInstallation? @relation(fields: [installationId], references: [id], onDelete: Cascade)
  deniedAttempts  AccessControlDeniedAttempt[]

  @@index([rut], map: "idx_ac_lists_rut")
  @@index([installationId, listType], map: "idx_ac_lists_installation_type")
  @@index([scope], map: "idx_ac_lists_scope")
  @@index([tenantId], map: "idx_ac_lists_tenant")
  @@map("access_control_lists")
  @@schema("access_control")
}

model AccessControlRecord {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId            String    @map("tenant_id")
  installationId      String    @map("installation_id") @db.Uuid
  recordType          String    @map("record_type") // 'visit','provider','vehicle','staff','delivery'
  rut                 String?
  fullName            String?   @map("full_name")
  company             String?
  documentSerial      String?   @map("document_serial")
  entryAt             DateTime  @default(now()) @map("entry_at") @db.Timestamptz(6)
  exitAt              DateTime? @map("exit_at") @db.Timestamptz(6)
  entryGuardId        String    @map("entry_guard_id") @db.Uuid
  exitGuardId         String?   @map("exit_guard_id") @db.Uuid
  entryGpsLat         Float?    @map("entry_gps_lat")
  entryGpsLng         Float?    @map("entry_gps_lng")
  exitGpsLat          Float?    @map("exit_gps_lat")
  exitGpsLng          Float?    @map("exit_gps_lng")
  vehiclePlate        String?   @map("vehicle_plate")
  vehiclePlatePhotoUrl String?  @map("vehicle_plate_photo_url")
  vehicleType         String?   @map("vehicle_type")
  vehicleBrandModel   String?   @map("vehicle_brand_model")
  visitorPhotoUrl     String?   @map("visitor_photo_url")
  credentialPhotoUrl  String?   @map("credential_photo_url")
  entrySignatureUrl   String?   @map("entry_signature_url")
  customFields        Json      @default("{}") @map("custom_fields") @db.JsonB
  qrSource            String?   @map("qr_source") // 'cedula_2013','cedula_2024','manual','preregistered'
  idValidationStatus  String    @default("not_checked") @map("id_validation_status") // 'valid','invalid','not_checked','error'
  listMatch           String?   @map("list_match") // 'whitelist','blacklist'
  preregistrationId   String?   @map("preregistration_id") @db.Uuid
  isSynced            Boolean   @default(true) @map("is_synced")
  deviceId            String?   @map("device_id")
  offlineCreatedAt    DateTime? @map("offline_created_at") @db.Timestamptz(6)
  entryObservations   String?   @map("entry_observations")
  exitObservations    String?   @map("exit_observations")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  installation    CrmInstallation              @relation(fields: [installationId], references: [id], onDelete: Cascade)
