  referenceReason String?      @map("reference_reason")

  currency     FinanceCurrency @default(CLP)
  exchangeRate Decimal?        @map("exchange_rate") @db.Decimal(10, 4)
  netAmount    Decimal         @map("net_amount") @db.Decimal(14, 2)
