  surveyVisitOpinion    String? @map("survey_visit_opinion")
  surveyExpectations    String? @map("survey_expectations") @db.Text
  surveyCurrentPainPoints String? @map("survey_current_pain_points") @db.Text
  surveySignatureUrl    String? @map("survey_signature_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         Admin           @relation("ops_visita_tecnica_supervisor", fields: [userId], references: [id])
  installation CrmInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
