// ============================================
// OPS — MARCACIÓN DIGITAL (Asistencia)
// ============================================

model OpsMarcacion {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String   @map("tenant_id")
  guardiaId        String   @map("guardia_id") @db.Uuid
  installationId   String   @map("installation_id") @db.Uuid
  puestoId         String?  @map("puesto_id") @db.Uuid
  slotNumber       Int?     @map("slot_number")
  tipo             String // "entrada" | "salida"
  timestamp        DateTime @default(now()) @db.Timestamptz(6)
  lat              Float?
  lng              Float?
  geoValidada      Boolean  @default(false) @map("geo_validada")
  geoDistanciaM    Float?   @map("geo_distancia_m") // distancia al centro de la instalación en metros
  metodoId         String   @default("rut_pin") @map("metodo_id") // "rut_pin" | "face_id" | "manual" | "import"
  fotoEvidenciaUrl String?  @map("foto_evidencia_url") // URL de la foto capturada al marcar (evidencia, no biométrica)
  faceConfidence   Float?   @map("face_confidence") // Confianza del match facial (0-100)
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  hashIntegridad   String   @map("hash_integridad") // SHA-256 del registro completo
  atrasoMinutos    Int?     @map("atraso_minutos") // minutos de atraso cuando tipo=entrada
  offlineSync      Boolean  @default(false) @map("offline_sync") // Marcación registrada offline
  deviceTimestamp  DateTime? @map("device_timestamp") @db.Timestamptz(6) // Timestamp del dispositivo (offline)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ── Resolución Exenta N°38 — Campos obligatorios ──
  employerRut           String?   @map("employer_rut")            // RUT empleador con formato XX.XXX.XXX-X
  employerName          String?   @map("employer_name")           // Razón social del empleador
  establishmentAddress  String?   @map("establishment_address")   // Dirección de la instalación al momento de la marca
  dtResolutionNumber    String?   @map("dt_resolution_number")    // N° resolución jornada excepcional DT (si aplica)
  mandanteRut           String?   @map("mandante_rut")            // RUT del mandante si es subcontrato
  mandanteName          String?   @map("mandante_name")           // Nombre del mandante
  gpsStatus             String    @default("sin_gps") @map("gps_status") // dentro_rango | fuera_rango | sin_gps
  distanciaMetros       Float?    @map("distancia_metros")        // Distancia al punto de referencia en metros
  gpsAccuracy           Float?    @map("gps_accuracy")            // Precisión del GPS en metros
  // ── Soft delete & auditoría de modificaciones ──
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy             String?   @map("deleted_by")
  modifiedAt            DateTime? @map("modified_at") @db.Timestamptz(6)
  modifiedBy            String?   @map("modified_by")
  modificationReason    String?   @map("modification_reason")
  isModified            Boolean   @default(false) @map("is_modified")
  pinFallbackReason     String?   @map("pin_fallback_reason") // "camera_error" | "low_light" | "aws_error" | "no_face_registered" | "user_choice"
  // ── Oposición del trabajador (Res. N°38 art. 19) ──
  oppositionToken       String?   @unique @map("opposition_token")  // token público para el formulario de oposición
  opposedAt             DateTime? @map("opposed_at") @db.Timestamptz(6)
  opposedBy             String?   @map("opposed_by")               // RUT del trabajador que se opuso
  oppositionReason      String?   @map("opposition_reason")
  consolidatedAt        DateTime? @map("consolidated_at") @db.Timestamptz(6) // cuando venció el plazo y se consolidó

  guardia                OpsGuardia              @relation(fields: [guardiaId], references: [id])
  installation           CrmInstallation         @relation(fields: [installationId], references: [id], onDelete: Restrict)
  puesto                 OpsPuestoOperativo?     @relation(fields: [puestoId], references: [id])
  asistenciaEntradas     OpsAsistenciaDiaria[]   @relation("asistencia_marcacion_entrada")
  asistenciaSalidas      OpsAsistenciaDiaria[]   @relation("asistencia_marcacion_salida")

  @@index([tenantId], map: "idx_ops_marcaciones_tenant")
  @@index([guardiaId], map: "idx_ops_marcaciones_guardia")
  @@index([installationId, timestamp], map: "idx_ops_marcaciones_inst_ts")
  @@index([timestamp], map: "idx_ops_marcaciones_timestamp")
  @@index([deletedAt], map: "idx_ops_marcaciones_deleted_at")
  @@map("marcaciones")
  @@schema("ops")
}

