# ============================================================================
# OPAI - Variables de Entorno (Plantilla de Referencia)
# ============================================================================
#
# IMPORTANTE:
# - Este archivo es solo REFERENCIA. NO contiene valores reales.
# - Los valores reales viven en Vercel (fuente de verdad).
# - Para desarrollo local: copiar este archivo a .env.local y completar
#   con los valores reales desde Vercel.
#
# NUNCA commitear .env.local (está en .gitignore).
#
# ============================================================================

# ─── AUTENTICACIÓN (REQUERIDO) ─────────────────────────────────────────────
#
# Secret para firmar tokens JWT y cookies de sesión (Auth.js v5)
# Generar con: openssl rand -base64 32
# ⚠️ CRÍTICO: Sin esta variable, el login fallará
#
AUTH_SECRET=your-auth-secret-here-min-32-chars

# Alternativa legacy (Auth.js acepta cualquiera de las dos)
# NEXTAUTH_SECRET=same-value-as-auth-secret


# ─── BASE DE DATOS (REQUERIDO) ─────────────────────────────────────────────
#
# Connection string de PostgreSQL (Neon)
# Formato: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&connection_limit=5&pool_timeout=20
# Obtener desde: https://console.neon.tech → Connection Details
# ⚠️ CRÍTICO: Sin esta variable, Prisma no puede conectar
#
# IMPORTANTE para producción (Vercel): Usar host con "-pooler" y añadir:
#   connection_limit=5  — evita timeouts cuando varias peticiones comparten la misma instancia
#   pool_timeout=20    — margen mayor antes de timeout (default 10s suele ser insuficiente)
# Sin estos parámetros, connection_limit=1 causa "Timed out fetching a new connection" (500).
#
DATABASE_URL=postgresql://user:password@host-pooler.region.neon.tech/dbname?sslmode=require&connection_limit=5&pool_timeout=20

# Conexión directa (sin pooler) para migraciones de Prisma
# Neon: misma URL pero SIN "-pooler" en el hostname
# Requerido para prisma migrate deploy y db push (advisory locks no funcionan vía pooler)
# Para desarrollo local con Docker: puede ser igual a DATABASE_URL
DIRECT_DATABASE_URL=postgresql://user:password@host.region.neon.tech/dbname?sslmode=require


# ─── EMAILS (REQUERIDO para envío de emails) ──────────────────────────────
#
# API Key de Resend para envío de emails
# Obtener desde: https://resend.com/api-keys
# ⚠️ Sin esta variable, las invitaciones de usuarios y envío de presentaciones fallarán
#
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email remitente (opcional, fallback: OPAI <opai@gard.cl>)
EMAIL_FROM=OPAI <opai@gard.cl>
EMAIL_REPLY_TO=[REDACTED]

# Secret para verificar firma (svix) de webhooks de Resend
# Obtener desde: https://resend.com/webhooks → Signing Secret
# ⚠️ CRÍTICO: Sin esta variable, los webhooks de Resend no verifican origen
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx


# ─── GMAIL OAUTH (CRM) ─────────────────────────────────────────────────────
#
# Client ID/Secret para OAuth Gmail (una vez por empresa)
# Obtener desde Google Cloud Console → APIs & Services → Credentials
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/crm/gmail/callback
GMAIL_TOKEN_SECRET=


# ─── URLs DE LA APLICACIÓN (REQUERIDO) ────────────────────────────────────
#
# URL pública del sitio (para links en emails y presentaciones)
# Local: http://localhost:3000
# Producción: [REDACTED]
# ⚠️ Afecta links generados en emails y presentaciones
#
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="Gard Security"

# URL base de la app (para activation links)
# ⚠️ CRÍTICO: Sin esta variable, los links de activación de usuario no funcionarán
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alternativa de SITE_URL (usado en algunos webhooks)
SITE_URL=http://localhost:3000


# ─── CMF / INDICADORES FINANCIEROS ────────────────────────────────────────
#
# API Key de CMF Chile para obtener UF/UTM diariamente
# Obtener desde: https://api.cmfchile.cl/
# Se usa en el cron /api/fx/sync
#
CMF_API_KEY=

# Secret para proteger el cron de Vercel (opcional, recomendado en prod)
# Generar con: openssl rand -hex 16
# Configurar en Vercel → Settings → Cron Job Protection
CRON_SECRET=


# ─── INTELIGENCIA ARTIFICIAL ───────────────────────────────────────────────
#
# Key de encriptación para API keys de proveedores de IA (AES-256-GCM)
# Generar con: openssl rand -hex 32
# ⚠️ CRÍTICO: Sin esta variable, no se pueden guardar API keys de IA
#
AI_ENCRYPTION_KEY=__64_hex_chars_use_openssl_rand_hex_32__

# API Key de OpenAI para generar descripciones AI en cotizaciones CPQ (legacy)
# Obtener desde: https://platform.openai.com/api-keys
#
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx

# Opcional: respaldo de búsqueda web para enriquecimiento CRM (Tavily API).
# Si falta, solo se usa OpenAI Responses con web_search cuando hay OPENAI_API_KEY.
# https://tavily.com/
TAVILY_API_KEY=

# Opcional: modelo para Responses API + web_search en /api/crm/company-enrich
# COMPANY_ENRICH_WEBSEARCH_MODEL=gpt-4.1-mini

# ─── GOOGLE MAPS (autocompletado de direcciones) ──────────────────────────
#
# Key de NAVEGADOR (mapas interactivos / autocompletado en el cliente).
# Restringida por HTTP referrer (lo normal para una key de browser).
# Obtener desde: Google Cloud Console → APIs & Services → Credentials
# Habilitar: Places API, Maps Static API, Maps JavaScript API
#
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXX

# Key SERVER-SIDE para Routes API / Geocoding (cálculo de kilometraje en
# rendiciones y geocodificación de direcciones).
# DEBE ser una key DISTINTA y SIN restricción de referrer (restringir por API:
# Routes API + Geocoding API, opcionalmente por IP).
# Una key restringida por referrer FALLA en llamadas server-side (Google responde
# REQUEST_DENIED / PERMISSION_DENIED) y el cálculo de distancia cae a línea recta.
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── CLOUDFLARE R2 (archivos CRM: adjuntos, negocios) ───────────────────────
#
# Almacenamiento de archivos (adjuntos de emails reenviados, documentos de negocios)
# Crear bucket en Cloudflare R2 y API Token con permisos de lectura/escritura
# Custom domain opcional (ej. files.gard.cl) para URLs públicas
#
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gard-files
R2_PUBLIC_URL=[REDACTED]

# ─── INBOUND EMAIL (leads por correo reenviado) ─────────────────────────────
#
# Dominio de recepción de correos inbound (Resend Inbound).
# Cada tenant recibe correos en {tenantSlug}@{INBOUND_DOMAIN}
# Ej: gard@inbound.opai.cl → tenant "gard"
# Webhook: configurar en Resend → Webhooks → email.received → URL de esta app
#
INBOUND_DOMAIN=inbound.opai.cl
NEXT_PUBLIC_INBOUND_DOMAIN=inbound.opai.cl

# ─── INTEGRACIONES OPCIONALES ──────────────────────────────────────────────

# Webhook de Zoho CRM (opcional, solo si se usa integración Zoho)
# Secret compartido para validar webhooks entrantes
# ZOHO_WEBHOOK_SECRET=your-shared-secret-with-zoho


# ─── ERP FINANCE (Contabilidad + Facturación) ────────────────────────────
#
# Proveedor DTE para emisión de facturas electrónicas SII
# Opciones: STUB (dev/testing), FACTO, NUBOX, BSALE
DTE_PROVIDER=STUB
DTE_API_KEY=
DTE_API_SECRET=
DTE_API_URL=https://api.facto.cl/v1
DTE_CERTIFICATE_PASSWORD=

# ─── CESIÓN ELECTRÓNICA (factoring) — App Octava ──────────────────────
# Cuando TenantDteConfig.cessionProvider="OCTAVA", el adapter Octava
# llama a https://www.appoctava.cl/apirestcesion/* para registrar al
# cedente, obtener token y enviar la cesión al RPETC del SII por nosotros.
# Costo: ~$1.000+IVA por factura cedida (cobrado al RUT integrador).
#
# Documentación: https://www.appoctava.cl/wscesion/documentacion-cesion-electronica-api-rest/
OCTAVA_INTEGRADOR_RUT=12345678-9
# Si tiene # , comillas obligatorias (dotenv trata # como comentario sin comillas)
OCTAVA_INTEGRADOR_PASSWORD=
# Si RegistraCedente responde que el RUT ya existe y no tienes octava_pass en BD:
# clave PassAccesoApi que Octava entregó al registrar el cedente (una vez; luego queda en BD cifrado).
# OCTAVA_PASS_ACCESO_API=

# Proveedor bancario para conexión/reconciliación
# Opciones: MANUAL (solo CSV), FINTOC
BANK_PROVIDER=MANUAL
FINTOC_API_KEY=
FINTOC_SECRET_KEY=


# ─── AWS REKOGNITION (Face Liveness / Rekognition) ─────────────────────────
#
# Credenciales para AWS Rekognition (Face Liveness, colección de rostros)
# Crear IAM user con permisos: rekognition, s3
#
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=***
AWS_REKOGNITION_COLLECTION_ID=gard-guardias
AWS_REKOGNITION_LIVENESS_BUCKET=gard-face-liveness


# ─── WEB PUSH (VAPID) ────────────────────────────────────────────────────
#
# Claves VAPID para Web Push Notifications (RFC 8292)
# Generar con: npx web-push generate-vapid-keys
# La clave publica tambien se expone al cliente via NEXT_PUBLIC_
#
VAPID_SUBJECT=mailto:soporte@gard.cl
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=


# ─── SENTRY (monitoreo de errores) ─────────────────────────────────────────
#
# DSN del proyecto en Sentry (obligatorio para habilitar error tracking)
# Crear proyecto en https://sentry.io → Settings → Client Keys (DSN)
# El cliente usa NEXT_PUBLIC_SENTRY_DSN; el servidor usa SENTRY_DSN o el mismo.
#
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# SENTRY_DSN=  # opcional; si no se define, se usa NEXT_PUBLIC_SENTRY_DSN en server/edge

# Solo para subida de source maps en CI/build (opcional)
# Crear en Sentry: Settings → Auth Tokens → Create New Token (project:releases)
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_xxxx


# ─── APOLLO.IO ─────────────────────────────────────────────────────────────
# API Key para enriquecimiento de contactos y empresas
# Obtener en: https://app.apollo.io/settings/integrations → API Keys
APOLLO_API_KEY=

# ─── VARIABLES DE SISTEMA (auto-gestionadas por Next.js/Vercel) ───────────
#
# Estas variables NO deben definirse manualmente:
# - NODE_ENV (development | production | test)
# - VERCEL_ENV (production | preview | development)
# - VERCEL_URL (auto en Vercel)
#
# ============================================================================

# ─── Ley 21.719 — Fase 2 ────────────────────────────────────────────────────
# Cifrado en reposo de campos sensibles de OpsPersona (afp, healthSystem, isapreName).
# Generar con: openssl rand -hex 32
# Si no se define, los valores quedan en texto plano (modo dev compatible).
PERSONA_ENCRYPTION_KEY=

# Feature flag: muestra el PIN de marcación almacenado en la ficha del guardia.
# Default false (Ley 21.719 — el PIN solo se ve UNA vez al generarse).
NEXT_PUBLIC_SHOW_PIN_PROFILE=false

# ─── Tickets: Email Conversation ─────────────────────────────────────────────
# Domain for inbound email (plus-addressing: tickets+{uuid}@reply.opai.cl)
TICKETS_INBOUND_DOMAIN=reply.opai.cl
# Webhook secret for inbound email verification
RESEND_INBOUND_WEBHOOK_SECRET=
# Inbound email provider: resend | mailgun | postmark
INBOUND_PROVIDER=resend
# If using Mailgun for inbound:
MAILGUN_WEBHOOK_SIGNING_KEY=

# ─── Cartolas bancarias por email ───────────────────────────────────────────
# Subdominio dedicado al inbox de cartolas. Cada tenant recibe un email
# único `cartola.<KEY>@<dominio>` (KEY = SHA256 del tenantId truncado).
# Se usa punto en lugar de `+` porque Santander Office Banking rechaza el
# plus-addressing como "formato no válido" en su validador.
# Configurar MX en este dominio en Resend Receiving y rutear el webhook
# email.received a https://opai.cl/api/inbound/cartola
CARTOLA_INBOUND_DOMAIN=cartola.opai.cl
# El webhook se autentica con la firma Svix usando RESEND_INBOUND_WEBHOOK_SECRET
# (definido más arriba en la sección de Tickets). El mismo secret sirve para
# todos los webhooks de Resend Receiving del tenant.

# ─── Web4Leads (movimientos bancarios en tiempo real) ───────────────────────
# Secret maestro para derivar secrets per-tenant (HMAC). Nunca compartir con
# Web4Leads; solo se entrega el secret derivado (ver scripts/web4leads-credentials.ts).
# Generar con: openssl rand -hex 32
WEB4LEADS_MASTER_SECRET=

# Psych — secreto HS256 para firmar invitaciones públicas (/t/psicotest/[token]).
# Genera con: openssl rand -base64 32
# Si está vacío en dev, se usa fallback inseguro; en producción es obligatorio.
PSYCH_TOKEN_SECRET=

# ─── Onboarding & Platform Alerts ───────────────────────────────────────────
# Email del super-admin que recibe notif de signups, errores, etc.
PLATFORM_ALERTS_EMAIL=carlos.irigoyen@opai.cl

# Cloudflare Turnstile (anti-bot en signup público)
# Crear en: https://dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=