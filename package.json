  "private": true,
  "scripts": {
    "dev": "npm run build && npm run start",
    "dev:watch": "node ./node_modules/next/dist/bin/next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && node ./node_modules/next/dist/bin/next dev",
    "build": "prisma generate && (prisma migrate resolve --rolled-back 20260514000000_add_company_presentations || true) && prisma migrate deploy && NODE_OPTIONS='--max-old-space-size=8192' next build",
